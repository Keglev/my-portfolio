{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.0.0",
    "react-icons": "^5.3.0",
    "react-scripts": "^5.0.1",
    "react-scroll": "^1.9.0",
    "styled-components": "^6.1.13"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint src --ext .js,.jsx",
    "test": "react-scripts test",
    "test:node": "jest --config=jest.node.config.js --runInBand --testPathPattern=src/__tests__",
    "test:cra": "react-scripts test --runInBand --watchAll=false",
    "test:all": "npm run test:node && npm run test:cra",
    "test:ci": "cross-env CI=true NODE_ENV=test npm run test:node && cross-env CI=true NODE_ENV=test npm run test:cra",
    "audit:ci": "node scripts/audit-check.js",
    "eject": "react-scripts eject",
    "docs:jsdoc": "jsdoc -c jsdoc.json",
    "docs:build": "node scripts/docs/build_docs.js && node scripts/docs/build_mermaid.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@vercel/speed-insights/react$": "<rootDir>/config/jest/speedInsightsMock.js"
    }
  },
  "overrides": {
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.3",
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "svgo": "^2.8.0",
    "resolve-url-loader": "^4.0.0",
    "serialize-javascript": ">=7.0.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.2",
    "marked": "^9.0.0",
    "node-fetch": "^2.7.0",
    "vite": "^8.1.5"
  }
}
