# Example environment file for local development and CI.
# Do NOT commit real secrets here. Use repository settings / actions secrets for CI.

# Vercel token used by CI deploy step
VERCEL_TOKEN=

# Web3Forms public access key for the contact form.
#
# The VITE_ prefix is required: Vite only exposes prefixed variables to
# client code (via import.meta.env), so an unprefixed name silently
# resolves to undefined at build time and the contact form posts an empty
# access key. Formerly REACT_APP_WEB3FORMS_KEY under Create React App.
#
# "Public" is accurate, not sloppy: Web3Forms access keys are designed to
# be visible in client-side bundles, and this value is baked into the
# deployed JavaScript. It is stored as a GitHub Actions secret only to
# keep it out of the git history, not because exposure would be a breach.
VITE_WEB3FORMS_KEY=
